{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"]},"docs":[{"location":"","title":"\u5386\u7a0b","text":"<p> \u7ea6 1814 \u4e2a\u5b57  \u9884\u8ba1\u9605\u8bfb\u65f6\u95f4 6 \u5206\u949f</p>","tags":["\u603b\u7ed3","\u4eba\u751f\u601d\u8003"]},{"location":"#_2","title":"\u539f\u56e0","text":"<p>\u4ece\u9ad8\u4e09\u6bd5\u4e1a\u5df2\u7ecf\u5f88\u591a\u5e74\u4e86\uff0c\u6211\u5199\u8fd9\u7bc7\u603b\u7ed3\u6587\u6863\u7684\u65f6\u95f4\u662f2024.12.5\uff08\u6211\u9ad8\u4e2d\u6bd5\u4e1a\u65f62023.6.7\uff09\uff0c\u8fd9\u4e2a\u65f6\u5019\u6211\u5728\u8bfb\u5927\u4e8c\u7684\u7b2c\u4e00\u5b66\u671f\uff0c\u6211\u6b64\u65f6\u7684\u751f\u6d3b\u8fc7\u5f97\u5e76\u4e0d\u597d\uff0c\u4e8e\u662f\u6211\u603b\u7ed3\u6027\u5730\u56de\u60f3\u8d77\u6765\u6211\u5230\u76ee\u524d\u4e3a\u6b62\u7684\u6574\u4e2a\u5927\u5b66\u751f\u6d3b\uff0c\u53d1\u73b0\u8fc7\u5f97\u786e\u5b9e\u5e76\u4e0d\u5982\u4eba\u610f\u3002\u8fd9\u4e5f\u662f\u6211\u4e3a\u4ec0\u4e48\u8981\u5199\u8fd9\u7bc7\u6587\u7ae0\u7684\u539f\u56e0\u3002</p>","tags":["\u603b\u7ed3","\u4eba\u751f\u601d\u8003"]},{"location":"#_3","title":"\u9ad8\u4e2d","text":"<p>\u56e0\u4e3a\u6211\u786e\u5b9e\u8bb0\u5f97\u9ad8\u4e2d\u4e09\u5e74\uff0c\u6211\u8fc7\u7684\u5f88\u5145\u5b9e\u5feb\u4e50\uff0c\u4e5f\u5f88\u6709\u6210\u5c31\u611f\uff0c\u603b\u7ed3\u770b\u4e0b\u6765\uff0c\u9ad8\u4e2d\u4e09\u5e74\uff0c\u9664\u4e86\u9ad8\u4e00\u4e00\u5e74\u7684\u4e0d\u9002\u5e94\uff0c\u65e0\u8bba\u662f\u5b66\u4e1a\u4e0a\u7684\u63a5\u89e6\u9ad8\u4e2d\u65b0\u77e5\u8bc6\u8fd8\u662f\u4eba\u9645\u6c9f\u901a\u4ea4\u5f80\u4e0a\uff08\u5f80\u5f80\u6307\u548c\u8001\u5e08\u4ee5\u53ca\u653f\u7b56\u3001\u89c4\u5219\u7684\u9002\u5e94\uff09\uff0c\u6211\u7684\u9ad8\u4e8c\u548c\u9ad8\u4e09\u8fc7\u5f97\u8fd8\u7b97\u8212\u670d\uff0c\u5177\u4f53\u7684\u8bb2\uff0c\u9ad8\u4e8c\u662f\u6211\u6210\u957f\u8fdb\u6b65\u6700\u5feb\u7684\u4e00\u5e74\uff0c\u9996\u5148\u6709\u4e86\u9ad8\u4e00\u4e0b\u5b66\u671f\u7684\u4e00\u4e9b\u8fdb\u5165\u6b63\u8f68\u7684\u57fa\u7840\u4e86\uff0c\u518d\u52a0\u4e0a\u6211\u5bf9\u6210\u529f\u7684\u5f3a\u70c8\u6e34\u671b\uff08\u56e0\u4e3a\u6211\u53d1\u73b0\u6211\u79bb\u7740\u6211\u7684\u76ee\u6807\u8d8a\u6765\u8d8a\u8fd1\uff0c\u4e8e\u662f\u6211\u4e5f\u6709\u4e00\u4e9b\u52a8\u529b\u53bb\u505a\u4e86\uff09\u4e8e\u662f\u6211\u8fdb\u6b65\u98de\u901f\u3002\u5960\u5b9a\u4e86\u6211\u6574\u4e2a\u9ad8\u4e2d\u7684\u5730\u4f4d\uff08\u5e74\u7ea7\u524d20\u6c34\u5e73\uff0c\u73ed\u7ea7\u524d\u4e09\u6216\u8005\u7b2c\u4e00\u6c34\u5e73\uff0c\u5bf9\u6807\u5230\u9ad8\u8003\uff0c\u534e\u79d1\u7684\u8ba1\u7b97\u673a\u6211\u90fd\u770b\u4e0d\u4e0a\uff09\u3002\u7136\u800c\u9ad8\u4e09\u4e00\u5e74\u7ea7\u5374\u663e\u5f97\u6709\u4e9b\u4e0b\u6ed1\uff0c\u6211\u7684\u8fdb\u6b65\u6b32\u671b\u6ca1\u6709\u90a3\u4e48\u5f3a\u70c8\u4e86\uff0c\u884c\u52a8\u529b\u6ca1\u6709\u90a3\u4e48\u5f3a\u4e86\uff08\u8fd8\u8bb0\u5f97\u9ad8\u4e8c\u8fd8\u5728\u7269\u5316\u653f\u7684\u65f6\u5019\u548c\u9648\u79d1\u5c79\u53bb\u8d70\u5eca\u4e0a\u5b66\u4e60\uff0c\u65e9\u4e0a\u8d77\u5f97\u7279\u522b\u65e9\u6765\u6559\u5ba4\u3002\uff09\uff0c\u6211\u4e5f\u53d8\u5f97\u7a0d\u5fae\u6709\u4e00\u4e9b\u6d51\u6d51\u5669\u5669\u8d77\u6765\uff0c\u5236\u5b9a\u8ba1\u5212\u7684\u52a8\u529b\u6ca1\u4e86\uff0c\u8f6c\u800c\u4ee3\u4e4b\u7684\u662f\u88ab\u52a8\u7684\u61d2\u60f0\u7684\u63a5\u53d7\u8001\u5e08\u7684\u6559\u6388\uff08\u5f53\u7136\u4e5f\u53ea\u662f\u6709\u65f6\u5019\u8fd9\u6837\uff09\u3002\u4e8e\u662f\u5728\u72b6\u6001\u8fd8\u4e0d\u9519\u7684\u60c5\u51b5\u4e0b\u53c2\u52a0\u9ad8\u8003\uff0c\u6700\u7ec8\u56e0\u4e3a\u751f\u7269\u548c\u5316\u5b66\u7684\u5931\u8bef\u8ba9\u6211\u7684\u6210\u7ee9\u5e76\u4e0d\u7406\u60f3\u3002</p>","tags":["\u603b\u7ed3","\u4eba\u751f\u601d\u8003"]},{"location":"#_4","title":"\u8fc7\u5ea6","text":"<p>\u7b49\u5230\u9ad8\u8003\u5b8c\uff0c\u6211\u7684\u8eab\u5fc3\u653e\u7eb5\u4e86\u8d77\u6765\uff0c\u6211\u9ad8\u4e2d\u52aa\u529b\u8fd9\u4e48\u591a\u5e74\uff0c\u4e3a\u7684\u5c31\u662f\u8fd9\u4e00\u523b\u3002\u4e8e\u662f\u6211\u51e0\u4e4e\u653e\u4e0b\u4e86\u6240\u6709\u548c\u5b66\u4e60\u76f8\u5173\u7684\u4e1c\u897f\uff0c\uff08\u5373\u4fbf\u62ff\u8d77\uff0c\u4e5f\u53ea\u662f\u65e0\u804a\u7684\u65f6\u5019\u7b80\u5355\u770b\u770b\u5927\u5b66\u7684\u4e1c\u897f\uff0c\u4e8b\u5b9e\u4e0a\u5c11\u4e4b\u53c8\u5c11\uff09\u6bd4\u5982\u6e38\u620f\uff0c\u611f\u60c5\uff0c\u8fd8\u6709\u6f2b\u65e0\u4f11\u6b62\u7684\u77ed\u89c6\u9891\u3002</p> <p>\u5176\u4e2d\u5bf9\u6211\u5f71\u54cd\u6700\u5927\u7684\u662f\u611f\u60c5\u3002\u56e0\u4e3a\u5728\u9ad8\u4e09\u4e0b\u5b66\u671f\u6211\u7a81\u7136\u6709\u4e86\u559c\u6b22\u7684\u5973\u751f\uff0c\u6211\u73b0\u5728\u751a\u81f3\u4e0d\u4ed4\u7ec6\u60f3\u90fd\u8bf4\u4e0d\u6e05\u8d77\u56e0\u5230\u5e95\u662f\u4ec0\u4e48\u3002\u5728\u9ad8\u8003\u524d\uff0c\u6211\u6b62\u4e0d\u4f4f\u601d\u5ff5\uff0c\u4f46\u662f\u5728\u5386\u4e8c\u7684\u538b\u6291\u73af\u5883\u4e0b\u6211\u4e0d\u80fd\u505a\u4ec0\u4e48\uff08\u4e8b\u5b9e\u4e0a\u5373\u4fbf\u6ca1\u6709\u6211\u4e5f\u4e0d\u6562\u505a\u4ec0\u4e48\uff09\uff0c\u6211\u53ea\u80fd\u4e0d\u65ad\u5730\u5199\u4fe1\uff0c\u5199\u65e5\u8bb0\u6765\u8212\u7f13\u6211\u7684\u601d\u5ff5\u4e4b\u60c5\uff0c\u8fd9\u4e5f\u79f0\u4e3a\u4e86\u6211\u9ad8\u4e09\u672b\u671f\u7684\u4e00\u6bb5\u5c0f\u63d2\u66f2\uff08\u4f46\u5e73\u5fc3\u800c\u8bba\uff0c\u5b83\u5e76\u6ca1\u6709\u5f71\u54cd\u6211\u7684\u9ad8\u8003\uff0c\u6362\u8a00\u4e4b\uff0c\u9ad8\u8003\u5931\u8bef\u548c\u5b83\u4e8b\u5b9e\u4e0a\u6ca1\u4ec0\u4e48\u5173\u7cfb\uff0c\u56e0\u4e3a\u6211\u4e5f\u5206\u5f97\u6e05\u8f7b\u91cd\uff09</p> <p>\u4e8e\u662f\u6211\u84c4\u8c0b\u5df2\u4e45\u5730\u5728\u9ad8\u8003\u540e\u548c\u5979\u8054\u7cfb\uff0c\u6700\u7ec8\u56e0\u4e3a<code>\u5927\u5b66\u4e0d\u5728\u4e00\u4e2a\u5730\u65b9</code>\u548c<code>\u5979\u5e76\u4e0d\u5145\u5206\u7684\u559c\u6b22\u6211\uff08\u7b80\u800c\u8a00\u4e4b\uff0c\u6211\u4eec\u505a\u670b\u53cb\u662f\u4e0d\u9519\u7684\u89d2\u8272\u626e\u6f14\uff0c\u4f46\u662f\u505a\u60c5\u4fa3\uff0c\u6211\u6b20\u7f3a\u4e00\u4e9b\u89d2\u8272\u5c5e\u6027\uff09</code>\u4ee5\u53ca\u53ef\u80fd\u6709\u4e00\u4e9b\u6211\u731c\u4e0d\u5230\u7684\u539f\u56e0\uff0c\u6211\u4eec\u6ca1\u6709\u5f00\u542f\u4e00\u6bb5\u611f\u60c5\uff0c\u6211\u53ea\u662f\u5728\u5c1d\u8bd5\u8ffd\u6c42\u5979\u7684\u8def\u4e0a\u4ed8\u51fa\u4e86\u5f88\u591a\u60c5\u611f\uff0c\u4e8b\u5b9e\u4e0a\uff0c\u8fd9\u4e9b\u60c5\u611f\u4e00\u76f4\u5f71\u54cd\u6211\u5230\u73b0\u5728\u3002</p> <p>\u4e8e\u662f\u5728\u5b8c\u5168\u8131\u79bb\u4e86\u9ad8\u4e2d\u72b6\u6001\u7684\u72b6\u6001\u4e0b\u6211\u8fc7\u5b8c\u4e86\u6211\u9ad8\u8003\u5b8c\u540e\u7684\u6691\u5047\u3002\u7136\u540e\u57fa\u672c\u6beb\u65e0\u51c6\u5907\u7684\u8fdb\u5165\u4e86\u5927\u5b66\u3002\u6211\u5f53\u65f6\u4ee5\u4e3a\uff0c\u51ed\u501f\u8fd9\u6211\u5386\u4e8c\u7684\u51fa\u8eab\uff0c\u6211\u80fd\u591f\u5728\u5927\u5b66\u6bd4\u522b\u7684\u540c\u5b66\u66f4\u5bb9\u6613\u5b8c\u6210<code>\u81ea\u5f8b</code>\u7684\u884c\u4e3a\uff0c\u6211\u4e5f\u80fd\u591f\u5728\u7ee9\u70b9\u4e0a\u6709\u6240\u4f5c\u4e3a\u3002\u6211\u8fd8\u76f8\u4fe1\u81ea\u5df1\u7684\u667a\u5546\uff0c\u6211\u76f8\u4fe1\u6211\u80fd\u4f7f\u7528\u9ad8\u6548\u7684\u65b9\u6cd5\uff08\u50cf\u6211\u9ad8\u4e2d\u4e00\u6837\uff09\uff0c\u7528\u6bd4\u522b\u4eba\u77ed\u7684\u65f6\u95f4\u5b66\u4f1a\u4e1c\u897f\u3002</p> <p>\u521a\u521a\u8fdb\u5165\u5927\u5b66\uff0c\u6211\u672c\u60f3\u7740\u6765\u5230\u4e0a\u79d1\u5927\u597d\u597d\u52aa\u529b\uff0c\u6211\u7684\u672c\u79d1\u867d\u7136\u4e0d\u5982\u5176\u4ed6985\u9662\u6821\u7684\u540c\u5b66\uff0c\u4f46\u662f\u6211\u53ef\u4ee5\u901a\u8fc7\u52aa\u529b\u6765\u4fdd\u7814\u5230\u66f4\u597d\u7684\u534e5\u9ad8\u6821\u3002\u4f46\u5176\u5b9e\u90a3\u4e2a\u65f6\u5019\u6211\u5e76\u4e0d\u77e5\u9053\u5728\u5927\u5b66\u5e94\u8be5\u600e\u4e48\u52aa\u529b\uff0c\u6211\u4e5f\u4e0d\u77e5\u9053\u4e3a\u4e86\u8fd9\u4e9b\u6211\u80fd\u52aa\u529b\u4e9b\u4ec0\u4e48\u3002\u5f53\u65f6\u53ea\u77e5\u9053\u7ee9\u70b9\u5f88\u91cd\u8981\u3002\u662f\u4fdd\u7814\u7684\u5173\u952e\u3002</p>","tags":["\u603b\u7ed3","\u4eba\u751f\u601d\u8003"]},{"location":"#_5","title":"\u5927\u5b66","text":"","tags":["\u603b\u7ed3","\u4eba\u751f\u601d\u8003"]},{"location":"#_6","title":"\u519b\u8bad\u671f","text":"<p>\u9996\u5148\u662f\u519b\u8bad\uff0c\u90a3\u4e2a\u65f6\u5019\u521a\u8fdb\u5165\u5927\u5b66\u6ca1\u4ec0\u4e48\u8ba4\u8bc6\u7684\u4eba\uff0c\u6709\u65f6\u5019\u611f\u89c9\u6709\u4e9b\u5b64\u72ec\uff0c\u7ecf\u5e38\u627e\u9ad8\u4e2d\u7684\u4e00\u4e9b\u670b\u53cb\u804a\u5929\uff0c\u5206\u4eab\u751f\u6d3b\u3002\u5f53\u65f6\u8fd8\u62b1\u6709\u5bf9\u7231\u60c5\u7684\u4e00\u4e1d\u5e7b\u60f3\u3002\u519b\u8bad\u65f6\u5019\u7684\u751f\u6d3b\u6211\u4e5f\u4e0d\u60f3\u8fc7\u591a\u56de\u5fc6\u3002</p>","tags":["\u603b\u7ed3","\u4eba\u751f\u601d\u8003"]},{"location":"#_7","title":"\u5927\u4e00\u4e0a","text":"<p>\u519b\u8bad\u7ed3\u675f\u540e\u8fdb\u5165\u5927\u5b66\uff0c\u6211\u662f\u8ba1\u7b97\u673a\u4e13\u4e1a\uff0c\u6240\u4ee5\u5f00\u59cb\u63a5\u89e6\u7f16\u7a0b\uff0c\u9996\u5148\u662f<code>python</code>\uff0c\u7136\u540e\u662f\u9ad8\u6570\u3001\u7ebf\u4ee3\u4ec0\u4e48\u7684\uff0c\u5f53\u65f6\u7279\u522b\u60a3\u5f97\u60a3\u5931\uff0c\u7279\u522b\u6267\u7740\u4e8e\u62a2\u4e00\u4e2a\u8bb2\u8bfe\u597d\u3001\u7ed9\u5206\u597d\u7684\u8001\u5e08\uff0c\u751f\u6015\u81ea\u5df1\u5403\u4e8f\uff0c\u4e5f\u7279\u522b\u6267\u7740\u4e8e\u5206\u6570\uff0c\u5c0f\u6d4b\u6263\u4e86\u4e00\u5206\u5c31\u60a3\u5f97\u60a3\u5931\u3002\u671f\u4e2d\u8003\u8bd5\u77e5\u9053\u4e86\u6210\u7ee9\u8fd8\u975e\u5f97\u63a8\u7b97\u4e00\u4e0b\u81ea\u5df1\u6392\u591a\u5c11\u540d\u3002</p> <p>[\u91cd\u70b9]\uff1a \u6211\u5927\u5b66\u8fc7\u5f97\u5e76\u4e0d\u81ea\u5f8b\uff0c\u6211\u4ece\u4e00\u5f00\u59cb\u65e9\u4e0a\u65e9\u8d77\uff0c\u53d8\u5f97\u8d8a\u6765\u8d8a\u559c\u6b22\u71ac\u591c\uff0c\u6211\u4e5f\u5728\u4e00\u4e9b\u4e0e\u5b66\u4e60\u65e0\u5173\u7684\u4e8b\u60c5\u4e0a\u6295\u5165\u4e86\u4e00\u4e9b\u7cbe\u529b\u548c\u65f6\u95f4\uff08\u4e5f\u597d\uff0c\u6bd5\u7adf\u5f53\u65f6\u597d\u5947\u4e00\u4e9b\u6d3b\u52a8\u548c\u9879\u76ee\u3002\u6bd4\u5982\u5f53\u65f6\u7ecf\u5e38\u6253\u7fbd\u6bdb\u7403\uff0c\u7ecf\u5e38\u8dd1\u6b65\u4ec0\u4e48\u7684\uff0c\u8fd9\u65e0\u53ef\u539a\u975e\uff0c\u4f46\u662f\u5f53\u65f6\u505a\u7684\u6709\u4e9b\u8fc7\u4e86\uff09\u3002\u540c\u65f6\u6211\u8fd8\u559c\u6b22\u6253\u6e38\u620f\u548c\u5237\u77ed\u89c6\u9891\uff0c\u8fd9\u4e5f\u548c\u6211\u9ad8\u8003\u5b8c\u90a3\u4e2a\u6691\u5047\u7684\u7231\u597d\u4e00\u6837\u3002\u8fd9\u8ba9\u6211\u4e0d\u80fd\u4e13\u5fc3\u5b66\u4e1a\uff0c\u6211\u7684\u8bfe\u7a0b\u5b66\u7684\u7a0b\u5ea6\u4e5f\u6ca1\u6709\u6211\u60f3\u8c61\u4e2d\u7684\u90a3\u4e48\u597d\u3002\u6211\u5f53\u65f6\u4e5f\u4f1a\u53bb\u51e0\u6b21\u56fe\u4e66\u9986\u5b66\u4e60\uff0c\u4f46\u6548\u7387\u597d\u50cf\u4e0d\u9ad8\uff08\u6211\u5f53\u65f6\u5e0c\u671b\u63d0\u5347\u81ea\u5df1\u7f16\u7a0b\u80fd\u529b\uff0c\u4f46\u8d70\u4e86\u5f88\u591a\u5f2f\u8def\uff0c\u4e0d\u5c55\u5f00\u8bf4\u4e86\uff09\u3002</p> <p>\u5927\u4e00\u4e0a\u7ed3\u675f\uff0c\u6211\u62ff\u5230\u4e86\u4e0d\u9519\u7684\u7ee9\u70b9\u548c\u6392\u540d\uff08\u5c3d\u7ba1\u6ca1\u5230\u6211\u7684\u9884\u671f\uff09\uff0c\u8fd9\u4e5f\u8ba9\u6211\u4fdd\u7814\u7684\u5e0c\u671b\u66f4\u591a\u4e86\u3002</p>","tags":["\u603b\u7ed3","\u4eba\u751f\u601d\u8003"]},{"location":"#_8","title":"\u5927\u4e00\u4e0b","text":"","tags":["\u603b\u7ed3","\u4eba\u751f\u601d\u8003"]},{"location":"#_9","title":"\u73b0\u5728\u7684\u95ee\u9898","text":"<p>\u5927\u5b66\u8ba9\u6211\u53d8\u4e86\u5f88\u591a\uff0c\u6211\u4e5f\u6ca1\u80fd\u5982\u613f\u50cf\u9ad8\u4e2d\u4e00\u6837\u81ea\u5f8b\u7684\u751f\u6d3b\u548c\u52aa\u529b\u3002\u6211\u73b0\u5728\u7684\u751f\u6d3b\u975e\u5e38\u7cdf\u7cd5\uff0c\u66f4\u522b\u8c08\u4ec0\u4e48\u8c08\u604b\u7231\u4e4b\u7c7b\u7684\u611f\u60c5\u4e8b\u60c5\u4e86\uff0c\u6211\u73b0\u5728\u662f\u771f\u7684\u5f88\u5904\u7406\u4e0d\u8fc7\u6765\uff0c\u4f46\u662f\u540c\u65f6\u6211\u53c8\u6709\u70b9\u62d6\u5ef6\uff0c\u884c\u52a8\u529b\u5dee\u3002</p> <p>\u5bf9\u6bd4\u4e00\u4e0b</p> \u9ad8\u4e2d \u5927\u5b66 \u665a\u4e0a\u5728\u5e8a\u4e0a \u80e1\u601d\u4e71\u60f3/\u7b2c\u4e8c\u5929\u7684\u89c4\u5212\u548c\u76ee\u524d\u7684\u4e0d\u8db3 \u80e1\u601d\u4e71\u60f3/\u7126\u8651 \u4f5c\u606f \u665a11\uff0c\u65e95:45\u8fdb\u5165\u5b66\u4e60\u72b6\u6001 \u665a12-2\uff0c\u65e97\uff1a30-10\uff0c\u8fd8\u4e0d\u4e00\u5b9a\u8fdb\u5165\u5b66\u4e60\u72b6\u6001 \u65f6\u95f4\u5b89\u6392 \u56fa\u5b9a\uff0c\u5b66\u4e60\u65f6\u95f4\u3001\u8d28\u91cf\u6709\u4fdd\u969c \u968f\u673a\uff0c\u66f4\u81ea\u7531\u4f46\u662f\u65f6\u95f4\u548c\u8d28\u91cf\u65e0\u4fdd\u969c \u5a31\u4e50 \u8bfe\u95f4\u548c\u540c\u5b66\u804a\u5929\uff0c\u5927\u8bfe\u95f4\u8dd1\u6b65\uff0c\u665a\u4e0a\u8dd1\u6b65\uff0c\u804a\u5929 \u6253\u6e38\u620f\uff0c\u5237\u89c6\u9891\uff0c\u770b\u7535\u5f71\uff0c\u8dd1\u6b65\uff0c\u6253\u7fbd\u6bdb\u7403\uff0c\u770b\u6d88\u606f\uff0c\u8d2d\u7269\uff0c\u611f\u60c5 \u7cbe\u795e\u72b6\u6001 \u7d2f\u4f46\u662f\u575a\u6301\uff0c\u6709\u65f6\u6ee1\u8154\u70ed\u8840\uff0c\u65e0\u77e5\uff0c\u5934\u8111\u7b80\u5355 \u8f7b\u677e\uff0c\u81ea\u7531\uff0c\u62d6\u5ef6\uff0c\u7126\u8651\uff0c\u6127\u759a\uff0c\u61ca\u6094\uff0c\u611f\u6168\uff0c\u538b\u529b <p>\u6240\u4ee5\uff0c\u5e94\u8be5\u600e\u4e48\u505a\u3002</p>","tags":["\u603b\u7ed3","\u4eba\u751f\u601d\u8003"]},{"location":"blog/","title":"Blog","text":"<p> \u672c\u7ad9\u76ee\u524d\u5171\u8bb0\u5f55  0  \u7bc7\u6587\u7ae0</p> <p>What will my blog record? </p>"},{"location":"blog/2025/12/24/%E9%9B%A8%E6%88%98%E4%BA%9A%E7%B4%A2800--%E6%9C%9F%E6%9C%AB%E5%91%A8%E4%B8%8Eproject%E8%80%83%E8%AF%95%E5%8D%9A%E5%BC%88/","title":"\u96e8\u6218\u4e9a\u7d22800 & \u671f\u672b\u5468\u4e0eproject+\u8003\u8bd5\u535a\u5f08","text":"<p> \u7ea6 763 \u4e2a\u5b57  \u9884\u8ba1\u9605\u8bfb\u65f6\u95f4 3 \u5206\u949f</p> <p>\u96e8\u6218\u4e9a\u7d22800 &amp; \u671f\u672b\u5468\u4e0eproject+\u8003\u8bd5\u535a\u5f08</p> <p>\u4eca\u5929\u5427\uff0c\u65e9\u4e0a\u5e94\u8be5\u662f 8 \u70b9\u534a\u5c31\u9192\u4e86\u3002\u8d77\u5e8a\u4e4b\u540e\u8d56\u4e86\u4f1a\u5e8a\uff0c\u8d77\u5e8a\u6548\u7387\u4e0d\u9ad8\uff0c\u770b\u4e86\u4f1a\u624b\u673a\u548c B \u7ad9\u3002\u867d\u7136\u770b\u7684\u662f\u4e9b\u6709\u7528\u7684\u4e1c\u897f\uff0c\u4f46\u603b\u4f53\u6765\u8bf4\uff0c\u6548\u7387\u5e76\u4e0d\u9ad8\u3002</p>","tags":["\u65e5\u8bb0","\u8dd1\u6b65","\u5b66\u4e60\u8bb0\u5f55"]},{"location":"blog/2025/12/24/%E9%9B%A8%E6%88%98%E4%BA%9A%E7%B4%A2800--%E6%9C%9F%E6%9C%AB%E5%91%A8%E4%B8%8Eproject%E8%80%83%E8%AF%95%E5%8D%9A%E5%BC%88/#log-of-today","title":"Log of Today","text":"<ul> <li>08:30 - 10:00 \u9192\u6765\uff0c\u8d56\u5e8a\uff0c\u770b B \u7ad9\u3002</li> <li>10:00 - 12:00 \u770b\u4e86\u770b\u670d\u52a1\u5668\uff0c\u770b\u4e4b\u524d\u81ea\u5df1\u5199\u7684 ShanghaiTech \u4f53\u80b2\u9986\u9879\u76ee\u7684\u524d\u540e\u7aef\u3002\u4e2d\u95f4\u6253\u4e86\u4f1a\u7687\u5ba4\u6218\u4e89\u3002</li> <li>12:00 - 14:00 \u6253\u4e86\u4f1a\u5403\u9e21\uff0c\u5237\u6296\u97f3\u3001\u5237\u89c6\u9891\u3002</li> <li>14:00 - 14:40 \u7761\u5348\u89c9\u3002</li> <li>14:40 - 17:35 \u4e0a\u903b\u8f91\u5bfc\u8bba\u8bfe\u3002\u4e00\u70b9\u6ca1\u542c\uff0c\u7eaf\u5199 \u6570\u503c\u6700\u4f18\u5316 Project \u4e86\u3002\u5728 Review \u4ee3\u7801\u4e0a\u6d6a\u8d39\u4e86\u633a\u591a\u65f6\u95f4\uff0c\u5feb\u4e0b\u8bfe\u624d Review \u5b8c\uff0c\u4ea4\u7ed9\u6d2a\u6c90\u5929\u53bb\u5199\u522b\u7684part\u7684\u7b97\u6cd5\u3002</li> <li>17:35 - 19:22 \u64cd\u573a\u96e8\u6218\u95f4\u6b47\u8dd1\u3002\u8dd1\u4e86\u201c\u4e9a\u7d22 800\u201d\uff08 10 \u7ec4 800 m\uff09\uff0c\u5e73\u5747\u914d\u901f 4 \u5206\u3002</li> <li>19:22 - 20:00 \u4f53\u80b2\u9986\u62c9\u4f38\u3002\u5916\u9762\u4e0b\u96e8\uff0c\u53bb\u9986\u91cc\u62c9\u4f38\u3001\u6eda\u6ce1\u6cab\u8f74\uff0c\u653e\u677e\u808c\u8089\u3002</li> <li>20:30 - 21:30 \u56de\u5bbf\u820d\u5012\u817e\u535a\u5ba2\u7cfb\u7edf\u3002</li> <li>21:30 - 23:00 \u6821\u95e8\u53e3\u4e70\u996d\uff0c\u56de\u6765\u8fb9\u5403\u8fb9\u914d\u535a\u5ba2\u7cfb\u7edf\uff0c\u5199\u65e5\u8bb0</li> </ul>","tags":["\u65e5\u8bb0","\u8dd1\u6b65","\u5b66\u4e60\u8bb0\u5f55"]},{"location":"blog/2025/12/24/%E9%9B%A8%E6%88%98%E4%BA%9A%E7%B4%A2800--%E6%9C%9F%E6%9C%AB%E5%91%A8%E4%B8%8Eproject%E8%80%83%E8%AF%95%E5%8D%9A%E5%BC%88/#_1","title":"\u8fd0\u52a8\u611f\u609f","text":"<p>\u4eca\u5929\u5929\u6c14\u662f\u9634\u5929\uff0c\u4e0b\u96e8\u4e86\uff0c\u4e00\u6574\u5929\u90fd\u633a\u9634\u7684\u3002\u672c\u6765\u8dd1\u4e2a LSD \u662f\u6bd4\u8f83\u597d\u7684\uff0c\u4f46\u4e0b\u96e8\u5929\u8dd1 LSD \u6dcb\u7740\u96e8\u6162\u6162\u8dd1\u5176\u5b9e\u4e0d\u8212\u670d\uff0c\u7eaf\u7eaf\u53d7\u7f6a\u53bb\u4e86\u3002\u6211\u5c31\u60f3\u7740\u4e0d\u5982\u6fc0\u60c5\u4e00\u70b9\uff0c\u8dd1\u4e2a\u95f4\u6b47\uff0c\u4e8e\u662f\u5c31\u8dd1\u4e86\u4e9a\u7d22 800\u3002</p> <p>\u8fd9\u4e2a\u53ef\u7b97\u662f\u575a\u6301\u4e0b\u6765\u4e86\uff0c\u8fc7\u7a0b\u4e0d\u592a\u5bb9\u6613\u3002\u8dd1 10 \u7ec4\uff0c\u7ec4\u95f4\u4f11\u606f 4 \u5206\u3002\u8dd1\u5230\u7b2c 3 \u4e2a\u7684\u65f6\u5019\u5176\u5b9e\u5c31\u633a\u7d2f\u4e86\uff0c\u4e0d\u60f3\u8dd1\u4e86\uff0c\u60f3\u8981\u4e0d\u8dd1 5 \u7ec4\u5c31\u5b8c\u4e86\uff0c\u4f46\u597d\u6b79\u575a\u6301\u4e0b\u6765\u4e86\u3002\u7b2c 5 \u7ec4\u662f\u6700\u7d2f\u7684\uff0c\u914d\u901f\u6389\u5230 4'15\"\u3002\u5230\u540e\u9762\u5c31\u6709\u79cd\u201c\u4e8c\u6b21\u547c\u5438\u201d\u7684\u611f\u89c9\u4e86\uff0c\u5fc3\u7387\u660e\u663e\u4f4e\u4e86\uff0c\u6ca1\u90a3\u4e48\u96be\u53d7\u4e86\u3002\u6700\u540e\u4e00\u4e2a\u8fd8\u884c\uff0c\u51b2\u4e86\u4e00\u628a\uff0c\u8dd1\u4e86 3'45\"\u3002</p> <p>\u8fd9\u4e2a\u8dd1\u5b8c\u771f\u662f\u8131\u80ce\u6362\u9aa8\u3002\u96e8\u6218\u95f4\u6b47\u786e\u5b9e\u4e0d\u5bb9\u6613\uff0c\u8dd1\u5b8c\u4e4b\u540e\u4e5f\u5f88\u723d\u5427\uff0c\u91ca\u653e\u4e86\u3002\u4e3a\u4eca\u5929\u7684\u8868\u73b0\u5f88\u81ea\u8c6a\uff01\uff01\uff01</p>","tags":["\u65e5\u8bb0","\u8dd1\u6b65","\u5b66\u4e60\u8bb0\u5f55"]},{"location":"blog/2025/12/24/%E9%9B%A8%E6%88%98%E4%BA%9A%E7%B4%A2800--%E6%9C%9F%E6%9C%AB%E5%91%A8%E4%B8%8Eproject%E8%80%83%E8%AF%95%E5%8D%9A%E5%BC%88/#project","title":"\u6b63\u5728\u8fdb\u884c\u7684 Project \u603b\u7ed3","text":"<p>\u73b0\u5728\u624b\u5934\u6709\u4e09\u4e2a Project\uff1a</p> <ol> <li>\u5b9e\u9a8c\u5ba4 Project (\u5c60\u53ef\u4f1f\u7ec4)\uff1a\u76ee\u524d\u4efb\u52a1\u662f\u770b\u8bba\u6587\u3001\u8dd1\u5b9e\u9a8c\u3002\u770b Loop Transformer \u76f8\u5173\u7684\u8bba\u6587\uff0c\u6bcf\u5929\u5f97\u76ef\u5b9e\u9a8c\u3002</li> <li>\u51f8\u4f18\u5316 Project\uff1a\u4e0b\u5468\u4e00\u8981 Pre\u3002\u5f97\u8ddf\u5c0f\u7ec4\u6210\u5458\u5546\u91cf\u600e\u4e48 Pre \u8fd8\u6709\u590d\u73b0\u7684\u76f8\u5173\u4e1c\u897f\u3002</li> <li>\u6570\u503c\u6700\u4f18\u5316 Project\uff1a\u4e0b\u5468\u65e5\u622a\u6b62\u3002\u4eca\u5929\u53ef\u7b97\u628a\u4ee3\u7801 Review \u5b8c\u4e86\uff0c\u540e\u9762\u4ea4\u7ed9\u7ec4\u5458\u53bb\u5199\u3002</li> </ol>","tags":["\u65e5\u8bb0","\u8dd1\u6b65","\u5b66\u4e60\u8bb0\u5f55"]},{"location":"blog/2025/12/24/%E9%9B%A8%E6%88%98%E4%BA%9A%E7%B4%A2800--%E6%9C%9F%E6%9C%AB%E5%91%A8%E4%B8%8Eproject%E8%80%83%E8%AF%95%E5%8D%9A%E5%BC%88/#to-do-list","title":"\u8ba1\u5212\u4e0e To-Do List","text":"<p>\u660e\u5929 (12/25 \u5468\u56db)</p> <ul> <li> \u4e0a\u5348\uff1a\u65e9\u8d77\uff0c\u590d\u4e60\u300a\u6570\u503c\u6700\u4f18\u5316\u300b\uff0c\u4e0b\u5468\u4e8c\u8981\u8003\u8bd5\u3002</li> <li> \u4e0b\u5348\uff1a\u7761\u5348\u89c9\uff0c\u51c6\u5907\u9ad8\u6570\u52a9\u6559\u4e60\u9898\u8bfe\u7684\u5185\u5bb9\u3002</li> </ul> <p>\u5468\u4e94 (12/26)</p> <ul> <li> \u4e0a\u5348\uff1a\u628a\u5b9e\u9a8c\u62a5\u544a\u6253\u51fa\u6765\u3002</li> <li> \u4e0b\u5348\uff1a\u590d\u4e60\u5b9e\u9a8c\uff0c\u4e0b\u5468\u8981\u8003\u5b9e\u9a8c\u3002</li> </ul> <p>\u5e74\u524d\u8ba1\u5212</p> <ul> <li> \u60f3\u53bb\u5916\u6ee9\u62cd\u4e2a\u673a\u4f4d\u3002\u627e\u4e2a\u80fd\u89c1\u5ea6\u9ad8\u7684\u65e9\u4e0a\uff0c\u65e9\u8d77\u53bb\u3002\u53ef\u80fd\u662f\u8fd9\u5468\u516d\uff0c\u6216\u8005\u8003\u5b8c\u8bd5\u518d\u53bb\u3002</li> </ul>","tags":["\u65e5\u8bb0","\u8dd1\u6b65","\u5b66\u4e60\u8bb0\u5f55"]},{"location":"blog/2025/12/24/%E9%9B%A8%E6%88%98%E4%BA%9A%E7%B4%A2800--%E6%9C%9F%E6%9C%AB%E5%91%A8%E4%B8%8Eproject%E8%80%83%E8%AF%95%E5%8D%9A%E5%BC%88/#_2","title":"\u603b\u7ed3","text":"<p>\u4eca\u5929\u4e0a\u5348\u786e\u5b9e\u6548\u7387\u4e0d\u9ad8\u3002\u6700\u8fd1\u4e5f\u633a\u5fd9\u7684\uff0c\u4e1c\u897f\u8fd8\u633a\u591a\u3002\u4eca\u665a\u867d\u7136\u60f3\u590d\u4e60\u6570\u503c\u6700\u4f18\u5316\uff0c\u4f46\u8dd1\u5b8c\u6b65\u633a\u7d2f\u4e5f\u633a\u56f0\u4e86\uff0c\u4e0d\u5982\u65e9\u70b9\u7761\uff0c\u660e\u5929\u65e9\u8d77\u590d\u4e60\u3002</p>","tags":["\u65e5\u8bb0","\u8dd1\u6b65","\u5b66\u4e60\u8bb0\u5f55"]},{"location":"blog/archive/2025/","title":"2025","text":""},{"location":"blog/category/2025%E5%B9%B412%E6%9C%88/","title":"2025\u5e7412\u6708","text":""}]}